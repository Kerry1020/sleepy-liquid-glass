{
  "schema": 1,
  "scope": "Publication copies of eight pre-existing Floating diagnostic receipts/logs only; no experiment executed by this publication step.",
  "raw_storage": {
    "path": ".local/raw",
    "ignored_by": ".gitignore",
    "rule": "/.local/",
    "byte_preserved": true,
    "publish": false
  },
  "format_policy": "Preserve UTF-8 bytes, whitespace, numbers, outcomes and line endings except the explicitly counted replacements below.",
  "replacement_rules": [
    {
      "id": "adb_serial_argument",
      "files": "*-device.json",
      "selector": "In the top-level command array, select the JSON string immediately after the sole element equal to -s.",
      "operation": "Replace that one quoted JSON string token, without reformatting the document.",
      "replacement": "<ANDROID_SERIAL>",
      "original_value_stored_in_manifest": false
    },
    {
      "id": "android_sdk_prefix",
      "pattern": "/Users/[^/\\s\"\\']+/Library/Android/sdk",
      "replacement": "<ANDROID_SDK>"
    },
    {
      "id": "sleepy_checkout_prefix",
      "pattern": "/Users/[^/\\s\"\\']+/\\.codex/worktrees/android-settings-glass-fixes/sleepy",
      "replacement": "<SLEEPY_CHECKOUT>"
    }
  ],
  "integrity_notes": [
    "The original log_sha256 values inside historical receipts refer to raw logs, not the redacted publication copies. PUBLICATION.json supplies the public hashes.",
    "SHA-256 values, source refs, UTC times, test outcomes, assertions and installed test-app/package hashes are not changed.",
    "adb process exit_code 0 does not mean the instrumentation tests passed; failure counts and raw JUnit failure output are retained."
  ],
